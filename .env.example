# =============================================================================
# CognoDB Cloud Benchmark - environment configuration
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# =============================================================================

# ---- Dataset ---------------------------------------------------------------
# Which sample to build. "pokec" downloads a slice of SNAP soc-Pokec.
# "synthetic" generates a seeded Barabasi-Albert-style graph locally (no
# internet needed) so the suite is runnable offline / in CI.
DATASET_SOURCE=synthetic
DATASET_TARGET_RELATIONSHIPS=150000
DATASET_SEED=42

# ---- Benchmark run parameters ----------------------------------------------
BENCH_READ_ITERATIONS=120
BENCH_WARMUP_ITERATIONS=20
BENCH_MIXED_DURATION_SECONDS=30
BENCH_MIXED_CONCURRENCY_LEVELS=1,10,40
BENCH_MIXED_READ_WRITE_RATIO=0.8
BENCH_BATCH_SIZE=1000
BENCH_MAX_RETRIES=3
BENCH_RETRY_BASE_DELAY_MS=250

# ---- CognoDB Cloud ----------------------------------------------------------
COGNODB_URI=bolt+s://<instance-id>.databases.cognodb.cloud
COGNODB_USER=cognodb
COGNODB_PASSWORD=
COGNODB_DATABASE=neo4j
COGNODB_INSTANCE_SPEC="burstable 0.5 vCPU, 256 MB RAM, 1 GB disk (free c0 tier)"

# ---- Neo4j AuraDB Free -------------------------------------------------------
NEO4J_URI=neo4j+s://<instance-id>.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
NEO4J_INSTANCE_SPEC="AuraDB Free: shared vCPU, 1 GB RAM, 1 GB storage"

# ---- Memgraph Cloud (bolt-compatible) ---------------------------------------
MEMGRAPH_URI=bolt+s://<instance-id>.memgraph.cloud:7687
MEMGRAPH_USER=memgraph
MEMGRAPH_PASSWORD=
MEMGRAPH_INSTANCE_SPEC="Memgraph Cloud free tier: 0.5 vCPU, 256 MB RAM, 1 GB disk"

# ---- ArangoDB Oasis (AQL) ----------------------------------------------------
ARANGODB_URL=https://<instance-id>.arangodb.cloud:8529
ARANGODB_USER=root
ARANGODB_PASSWORD=
ARANGODB_DATABASE=benchmark
ARANGODB_INSTANCE_SPEC="Oasis free trial: 2 vCPU / 2 GB RAM shared, capped to match smallest tier"

# ---- FalkorDB Cloud (Redis protocol, Cypher subset) --------------------------
FALKORDB_URL=redis://default:<password>@<instance-id>.falkordb.cloud:6379
FALKORDB_GRAPH_NAME=benchmark
FALKORDB_INSTANCE_SPEC="FalkorDB Cloud free tier: 0.5 vCPU, 256 MB RAM"

# ---- API server (optional dashboard/monitoring backend) ---------------------
PORT=4000
NODE_ENV=development
LOG_LEVEL=info
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=60
CACHE_TTL_SECONDS=30
API_KEY=change-me-local-dev-only
