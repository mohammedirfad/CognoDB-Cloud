{
  "name": "cognodb-cloud-benchmark",
  "version": "1.0.0",
  "description": "Reproducible benchmark suite comparing CognoDB Cloud against Neo4j AuraDB, Memgraph, ArangoDB Oasis and FalkorDB Cloud under identical free-tier resource limits.",
  "license": "MIT",
  "private": true,
  "type": "commonjs",
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "dataset:download": "tsx src/dataset/download.ts",
    "dataset:prepare": "tsx src/dataset/prepare.ts",
    "bench:load": "tsx src/cli.ts load",
    "bench:run": "tsx src/cli.ts run",
    "bench:report": "tsx src/cli.ts report",
    "bench:all": "tsx src/cli.ts load && tsx src/cli.ts run && tsx src/cli.ts report",
    "api:dev": "tsx watch src/api/server.ts",
    "build": "tsc -p tsconfig.json",
    "api:start": "node dist/api/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "test": "vitest run"
  },
  "dependencies": {
    "arangojs": "^8.8.1",
    "cli-table3": "^0.6.5",
    "commander": "^12.1.0",
    "cors": "^2.8.5",
    "csv-parse": "^5.5.6",
    "csv-stringify": "^6.5.1",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "neo4j-driver": "^5.24.0",
    "node-cache": "^5.1.2",
    "p-limit": "^3.1.0",
    "pino": "^9.4.0",
    "pino-http": "^10.3.0",
    "pino-pretty": "^11.2.2",
    "redis": "^4.7.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.15",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.0",
    "prettier": "^3.3.3",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}
